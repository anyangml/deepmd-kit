    "descriptor": {
      "type": "dpa3",
      "repflow": {
        "n_dim": 128,
        "e_dim": 64,
        "a_dim": 32,
        "nlayers": 16,
        "e_rcut": 6.0,
        "e_rcut_smth": 5.3,
        "e_sel": 1200,
        "a_rcut": 4.0,
        "a_rcut_smth": 3.5,
        "a_sel": 300,
        "axis_neuron": 4,
        "skip_stat": true,
        "a_compress_rate": 1,
        "a_compress_e_rate": 2,
        "a_compress_use_split": true,
        "update_angle": true,
        "smooth_edge_update": true,
        "use_dynamic_sel": true,
        "sel_reduce_factor": 10.0,
        "use_env_envelope": true,
        "update_style": "res_residual",
        "update_residual": 0.1,
        "update_residual_init": "const"
      },
      "activation_function": "custom_silu:3.0",
      "precision": "float32",
      "use_tebd_bias": false,
      "concat_output_tebd": false
    },
    "fitting_net": {
      "type": "polymer_pool",
      "property_name": "cloud_point",
      "task_dim": 1,
      "intensive": true,
      "n_roles": 2,
      "numb_fparam": 38,
      "numb_aparam": 3,
      "head_neuron": [
        256,
        256
      ],
      "head_activation": "silu",
      "head_dropout": 0.1,
      "pool_norm": "layer",
      "seed": 1,
      "_comment": "numb_aparam must equal n_roles+1; aparam=[w,role0,role1]. fparam(38)=process params, pre-standardized by polymer_to_dpdata.py."
    }
  },
  "learning_rate": {
    "type": "exp",
    "start_lr": 0.001,
    "stop_lr": 1e-05,
    "decay_steps": 2000,
    "_comment": "head_lr; e2e also finetunes descriptor"
  },
  "loss": {
    "type": "property",
    "metric": [
      "mae",
      "rmse"
    ],
    "loss_func": "smooth_mae",
    "beta": 1.0,
    "_comment": "SmoothL1, matches the reference group_property_e2e"
  },
  "training": {
    "training_data": {
      "systems": [
        "PATH/TO/dpdata_polymer/train"
      ],
      "batch_size": 1
    },
    "validation_data": {
      "systems": [
        "PATH/TO/dpdata_polymer/val"
      ],
      "batch_size": 1
    },
    "numb_steps": 200000,
    "gradient_max_norm": 5.0,
    "seed": 10,
    "disp_file": "lcurve.out",
    "disp_freq": 200,
    "save_freq": 5000,
    "_comment": "one polymer = one frame = one system, so batch_size is 1"
  }
}